  "narrative": {
    "northStar": "The Clear Settlement Desk",
    "overview": "RecallRelay is a working payments dashboard for merchants handling a safety recall. White work surfaces, a quiet cool sidebar, a compact type scale, and an explicit warning strip make status and action easy to find. The refund timeline is the one distinctive visual move: it turns a deadline into a readable order of work while keeping the same restrained component system. The system is exact and calm. It treats a hazard plainly, exposes simulated and sandbox state, and places evidence beside financial decisions. The rejected case-file styling is not part of this system.",
    "keyCharacteristics": [
      "Dense, aligned data tables and compact controls.",
      "Soft state fills with words and icons where useful.",
      "A deliberate approval card next to the order table.",
      "Consistent merchant shell and checkout-like buyer flow."
    ],
    "rules": [
      {
        "name": "The Meaningful Color Rule",
        "body": "A status color always has a visible word. Danger is reserved for hazards, urgent work, or review, never general decoration.",
        "section": "colors"
      },
      {
        "name": "The Financial Numeral Rule",
        "body": "Keep currency symbols, amounts, and ISO currency codes together and aligned with tabular numerals. Never imply a cross-currency total.",
        "section": "typography"
      },
      {
        "name": "The Decision Adjacency Rule",
        "body": "Place the plan's budget and approval beside the order table so every proposed money movement is in view at the decision point.",
        "section": "layout"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Use borders and spacing to structure work; reserve shadows for controls and overlays.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep safety hazards explicit and visually prominent.",
      "Do show status in words alongside color and use visible keyboard focus.",
      "Do keep merchant data dense, aligned, and legible at 768 px."
    ],
    "donts": [
      "Don't revive beige paper, serif headings, stamps, double rules, or editorial case-file styling.",
      "Don't use gradients, glass, pure black fills, or Unicode glyphs as icons.",
      "Don't put amounts in monospace or add different currencies together."
    ]
  }
}
